<layout item_spacing.y="12">
    <text size="heading">Todos</text>
    <layout direction="left_to_right" item_spacing.x="8">
        <text_edit id="draft" e-model="draft" placeholder="What needs to be done?" width="320"
                   autofocus="true" @submit="add" />
        <button id="add" :disabled="!can_add" @click="add">Add</button>
    </layout>
    <fragment e-if="has_todos">
        <checkbox id="toggle_all" e-model="all_done">Mark all as complete</checkbox>
        <layout e-for="todo in todos" id="todo" direction="left_to_right" item_spacing.x="8" cross_align="center">
            <text_edit e-if="todo.editing" id="edit" e-model="todo.draft" width="300" autofocus="true"
                       @submit="todo.save" @blur="todo.save" @cancel="todo.cancel" />
            <!-- While editing, only the field is shown, as in TodoMVC. -->
            <fragment e-else>
                <checkbox id="done" e-model="todo.done" />
                <text id="title" @double_click="todo.edit"
                      :color="todo.done ? $theme.colors.gray.l6 : $theme.colors.fg.base"
                      :strikethrough="todo.done">{{ todo.title }}</text>
                <!-- Double-click cannot be done from the keyboard; the button can. -->
                <button id="edit_button" size="sm" variant="ghost" @click="todo.edit">Edit</button>
                <!-- As in TodoMVC, Delete shows while the pointer is over the row; it keeps its space. -->
                <button id="remove" size="sm" variant="ghost" :visible="$contains_pointer.todo"
                        @click="todo.remove">Delete</button>
            </fragment>
        </layout>
        <text>{{ remaining }}</text>
        <layout direction="left_to_right" item_spacing.x="4">
            <button id="all" size="sm" :variant="showing_all ? 'outline' : 'ghost'" @click="show_all">All</button>
            <button id="active" size="sm" :variant="showing_active ? 'outline' : 'ghost'" @click="show_active">Active</button>
            <button id="completed" size="sm" :variant="showing_completed ? 'outline' : 'ghost'" @click="show_completed">Completed</button>
        </layout>
        <layout direction="left_to_right" item_spacing.x="8">
            <button e-if="any_done" id="clear" size="sm" variant="outline" @click="clear_completed">Clear completed</button>
        </layout>
    </fragment>
    <text e-else>Nothing to do yet.</text>
</layout>
