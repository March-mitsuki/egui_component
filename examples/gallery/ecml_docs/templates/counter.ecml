<layout item_spacing.y="12">
    <text size="heading">Counter</text>
    <text_edit id="name" e-model="name" placeholder="Your name" width="260" />
    <text>Hello, {{ name }}. Count: {{ count }}</text>
    <layout direction="left_to_right" item_spacing.x="8" cross_align="center">
        <switch id="enabled" e-model="enabled" />
        <text>Enable increment (stops at 10)</text>
    </layout>
    <layout direction="left_to_right" item_spacing.x="8">
        <button :disabled="!can_increment" @click="increment">Increment</button>
        <button variant="outline" @click="reset">Reset</button>
    </layout>
</layout>
