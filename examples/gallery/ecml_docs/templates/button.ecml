<layout item_spacing.y="12">
    <layout direction="left_to_right" item_spacing.x="8">
        <button>Solid</button>
        <button variant="surface">Surface</button>
        <button variant="outline">Outline</button>
        <button variant="ghost">Ghost</button>
    </layout>
    <layout direction="left_to_right" item_spacing.x="8" cross_align="center">
        <button size="xs">xs</button>
        <button size="sm">sm</button>
        <button size="md">md</button>
        <button size="lg">lg</button>
        <button width="140">width 140</button>
    </layout>
    <layout direction="left_to_right" item_spacing.x="8">
        <button :disabled="!can_increment" @click="increment">Increment ({{ count }})</button>
        <button variant="outline" @click="reset">Reset</button>
        <button disabled="true">Disabled</button>
        <!-- Loading ignores clicks but keeps keyboard focus. -->
        <button variant="surface" :loading="enabled">Loading while enabled</button>
    </layout>
    <!-- Icons come from .bind(); an icon-only button needs aria_label. -->
    <layout direction="left_to_right" item_spacing.x="8" cross_align="center">
        <button variant="outline" :icon_left="enabled ? heart : heart_off">Liked: {{ enabled }}</button>
        <button variant="ghost" :icon_left="settings" aria_label="Settings" />
    </layout>
</layout>
